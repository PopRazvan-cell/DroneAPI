# Runtime
AGRIDRONE_ENV=dev
AGRIDRONE_SECRET_KEY=dev-only-change-me
AGRIDRONE_DEV_TOKEN=dev-token
AGRIDRONE_LOG_LEVEL=INFO
AGRIDRONE_PUBLIC_URL=http://localhost:7100
AGRIDRONE_CORS_ORIGINS=http://localhost:5173

# Data and storage (host paths; Docker overrides them with /data)
AGRIDRONE_DATA_DIR=./data
AGRIDRONE_STORAGE_DIR=./data/store

# Photogrammetry (host-visible NodeODM port; inside Compose the API uses nodeodm:3000)
AGRIDRONE_PHOTOGRAMMETRY_MODE=mock
AGRIDRONE_NODEODM_URL=http://localhost:7104

# Database and Redis as seen from the host.
# MySQL is an existing container on the host; this stack does not start one.
AGRIDRONE_DATABASE_URL=mysql+asyncmy://agridrone:agridrone@localhost:3306/agridrone
AGRIDRONE_REDIS_URL=redis://localhost:7103/0
AGRIDRONE_TUS_URL=http://localhost:7101/files/

# Existing MySQL connection used by the api/worker containers.
# MYSQL_HOST is resolved inside Docker via extra_hosts; set it to another
# host/network name if the MySQL container is reachable differently.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=agridrone
MYSQL_USER=agridrone
MYSQL_PASSWORD=agridrone

# Host ports for the services started by this compose file (7100-7200)
REDIS_PORT=7103
API_PORT=7100
TUSD_PORT=7101
NODEODM_PORT=7104

# Exported automatically by the Makefile. Override only when running compose by hand.
# AGRIDRONE_UID=1000
# AGRIDRONE_GID=1000
